# Linq Partner API token (Bearer). Get one at dashboard.linqapp.com/api-tooling
LINQ_API_KEY=your-linq-token-here

# The Linq phone number the bot texts from (E.164). List yours with: npm run numbers
LINQ_FROM_NUMBER=+16504336715

# Webhook signing secret returned when you create the subscription (starts with whsec_).
# Leave blank during local testing to skip signature verification (NOT for production).
LINQ_WEBHOOK_SECRET=

# Public HTTPS URL where Linq should deliver webhooks (e.g. your ngrok URL + /webhooks/linq).
# Used by: npm run register-webhook
PUBLIC_WEBHOOK_URL=

# Port the webhook server listens on locally.
PORT=3000

# Admin phone (E.164). When set, the DATA and CLEAR commands only work from this
# number. Leave blank to allow anyone (not recommended in production).
OWNER_PHONE=

# Persistent storage (optional locally; required on ephemeral hosts like Render).
# Get these from an Upstash Redis database (console.upstash.com). When both are
# set, scores are stored in Redis; otherwise they go to data/scores.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
